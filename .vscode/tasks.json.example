{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CodexPro: Start",
      "type": "shell",
      "command": "codexpro start",
      "options": {
        "env": {
          "CODEXPRO_BASH_MODE": "full"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    },
    {
      "label": "CodexPro: Watch Handoff",
      "type": "shell",
      "command": "codexpro watch-handoff --agent codex --model gpt-5.6-terra --timeout-ms 1800000 --yes",
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    }
  ]
}
